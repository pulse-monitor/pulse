# Pulse 探针镜像。
#
# 基于 scratch：agent 是静态链接的 musl 二进制，**不需要 shell、不需要包管理器**。
# 顺带消除了「攻击者拿到容器后 docker exec 进去」的可能 —— 里面没有 shell 可执行。
#
# 构建（在仓库根目录）：
#   docker build -f deploy/docker/Dockerfile.agent -t pulse-agent .
#
# ⚠️ 本文件尚未在真实 Docker 环境验证过（开发机上没装 Docker）。

FROM --platform=$BUILDPLATFORM rust:1.98-alpine AS builder
ARG TARGETARCH
RUN apk add --no-cache musl-dev
WORKDIR /src
COPY . .
RUN case "$TARGETARCH" in \
      amd64) T=x86_64-unknown-linux-musl ;; \
      arm64) T=aarch64-unknown-linux-musl ;; \
      *) echo "unsupported arch: $TARGETARCH" >&2; exit 1 ;; \
    esac && \
    rustup target add "$T" && \
    cargo build --release -p pulse-agent --target "$T" --locked && \
    cp "target/$T/release/pulse-agent" /pulse-agent

FROM scratch
COPY --from=builder /pulse-agent /pulse-agent
# 以非 root 运行。scratch 里没有 /etc/passwd，用数字 UID。
USER 65532:65532
ENTRYPOINT ["/pulse-agent"]
