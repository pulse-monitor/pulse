# Pulse Server 镜像。
#
# 三段构建：前端 → 后端 → 运行镜像。
# 前端必须一起打进来 —— Server 要靠 PULSE_WEB_DIR 提供静态文件，
# 只装二进制的话打开是一片空白。

# ── 前端 ──
#
# 前端在**另一个仓库**（pulse-web），这里下它的 Release 产物。
#
# 早先是 `git clone --branch main` 现场构建，那样有两个毛病：
#
#   1. **镜像里是哪个版本的前端，取决于「构建那一刻 main 长什么样」** ——
#      事后无从查证，也没法复现某个历史镜像。
#   2. **buildx 的层缓存会骗人**：clone 那一层的缓存键只看命令文本，
#      main 往前走了它照样命中，于是新提交根本进不了镜像。
#      实测踩到：修复提交比镜像构建早 16 分钟，镜像里却还是旧代码。
#
# 现在钉死版本号，改版本必须改这里 —— 显式、可复现、缓存也骗不了人。
FROM --platform=$BUILDPLATFORM alpine:3.22 AS web
ARG PULSE_WEB_VERSION=0.0.5
ARG PULSE_WEB_REPO=pulse-monitor/pulse-web
RUN apk add --no-cache curl tar
WORKDIR /web
# 摘要要校验：下到半截或被中间人换掉都得当场失败，而不是打进镜像。
#（注意不能把 # 注释写进下面的续行里 —— shell 会把 # 之后到行尾整个吃掉）
RUN set -eux; \
    base="https://github.com/${PULSE_WEB_REPO}/releases/download/v${PULSE_WEB_VERSION}"; \
    curl -fsSL "$base/pulse-web-dist.tar.gz" -o dist.tgz; \
    curl -fsSL "$base/SHA256SUMS" -o sums; \
    want=$(awk '/pulse-web-dist\.tar\.gz$/{print $1}' sums | head -1); \
    got=$(sha256sum dist.tgz | awk '{print $1}'); \
    [ "$want" = "$got" ] || { echo "前端产物摘要不符: 期望 $want 实际 $got" >&2; exit 1; }; \
    tar xzf dist.tgz; \
    rm -f dist.tgz sums; \
    test -f dist/index.html

# ── 后端 ──
#
# --platform=$BUILDPLATFORM + 交叉编译，**不用 QEMU**。
#
# 之前是让 buildx 用 QEMU 模拟目标架构再在里面原生编。Rust 这边本来就是
# lto="fat" + codegen-units=1 的最慢配置，套一层模拟直接慢一个数量级 ——
# 实测多架构一次 39 分钟。改成在构建机的原生架构上交叉编译后，
# 两个架构都是原生速度。
#
# 用 GNU 目标而不是 musl：运行镜像是 distroless/cc（glibc），
# 而交叉工具链 Debian 源里就有（gcc-aarch64-linux-gnu），
# 不必额外引入 zig 之类的外部下载。
FROM --platform=$BUILDPLATFORM rust:1.90-bookworm AS builder
ARG TARGETARCH
WORKDIR /src

# 按目标架构装交叉工具链并登记 rust target。
#
# ring 的 build script 要**目标平台的 C 编译器**，所以下面的 CC_* 必须设对；
# 只 `rustup target add` 是不够的，链接会直接失败。
#
# libc6-dev-arm64-cross 同样不能省：只装 gcc-aarch64-linux-gnu 的话没有目标
# 平台的 libc 头，编译器会去翻宿主的 /usr/include，然后卡在
# "bits/libc-header-start.h: No such file"（实测踩到）。
# --no-install-recommends 正好会把它跳过，所以必须显式写出来。
RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) echo x86_64-unknown-linux-gnu > /target.txt ;; \
      arm64) apt-get update; \
             apt-get install -y --no-install-recommends \
               gcc-aarch64-linux-gnu libc6-dev-arm64-cross; \
             rm -rf /var/lib/apt/lists/*; \
             echo aarch64-unknown-linux-gnu > /target.txt ;; \
      *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    rustup target add "$(cat /target.txt)"

ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    AR_aarch64_unknown_linux_gnu=aarch64-linux-gnu-ar

# 依赖清单先行：改代码不会让依赖编译的缓存失效
COPY Cargo.toml Cargo.lock ./
COPY crates/pulse-proto/Cargo.toml crates/pulse-proto/
COPY crates/pulse-server/Cargo.toml crates/pulse-server/
COPY crates/pulse-loadgen/Cargo.toml crates/pulse-loadgen/
RUN mkdir -p crates/pulse-proto/src crates/pulse-server/src crates/pulse-loadgen/src \
 && echo 'fn main() {}' > crates/pulse-server/src/main.rs \
 && echo '' > crates/pulse-proto/src/lib.rs \
 && echo 'fn main() {}' > crates/pulse-loadgen/src/main.rs \
 && cargo build --release -p pulse-server --locked --target "$(cat /target.txt)" || true
COPY . .
# 上一步留下的假产物要清掉，否则 cargo 认为不用重编
RUN touch crates/*/src/*.rs \
 && cargo build --release -p pulse-server --locked --target "$(cat /target.txt)" \
 && cp "target/$(cat /target.txt)/release/pulse-server" /pulse-server
# 一个属主正确的空 /data 带到运行镜像去（下面解释为什么非这样不可）
RUN mkdir -p /out/data

# ── 运行 ──
# distroless 而不是 scratch：要读写 SQLite、要时区数据、要 CA 根证书
#（拉汇率和 GeoIP 数据库要走 HTTPS）。同样没有 shell。
FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=builder /pulse-server /pulse-server
COPY --from=web /web/dist /web/dist

# /data 必须在镜像里就存在、且属主是 65532。
#
# Docker 建具名卷时会照搬镜像里同名目录的属主和权限；镜像里没有的话，
# 卷就是 root:root，而容器以 65532 跑 —— SQLite 直接
# "unable to open database file"，容器起都起不来（实测）。
# distroless 没有 shell，RUN mkdir 用不了，只能从 builder 拷一个空目录过来。
#
# 注意：**bind mount 不吃这一套**。`-v /宿主/路径:/data` 用的是宿主目录的
# 属主，得自己 `chown 65532:65532 /宿主/路径`。
COPY --from=builder --chown=65532:65532 /out/data /data

# distroless 的 nonroot 是 uid 65532
USER 65532:65532
VOLUME ["/data"]
ENV PULSE_DATABASE_URL=sqlite:///data/pulse.db \
    PULSE_DATA_DIR=/data \
    PULSE_WEB_DIR=/web/dist \
    PULSE_BIND=0.0.0.0:25774
EXPOSE 25774
ENTRYPOINT ["/pulse-server"]
