<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS launchd 配置。

  放在 ~/Library/LaunchAgents/（用户级，无需 root）或
  /Library/LaunchDaemons/（系统级，需 root）。

  用户级是默认推荐：agent 只读系统指标，不需要系统级权限。
  代价是用户登出后会停 —— 服务器场景通常用系统级。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pulse.agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/pulse-agent</string>
    </array>

    <!-- token 走环境变量，不进命令行（命令行 ps 可见） -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PULSE_SERVER</key>
        <string>wss://panel.example.com</string>
        <key>PULSE_TOKEN</key>
        <string>PLACEHOLDER_TOKEN</string>
        <key>PULSE_LOG</key>
        <string>info</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <!-- 防无限重启 -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/usr/local/var/log/pulse-agent.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/pulse-agent.err</string>

    <!-- 只读系统指标，不需要任何额外授权 -->
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
